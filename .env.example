# Environment for `supabase/config.toml` interpolation.
#
# Copy to `.env` (gitignored) for local development. The Supabase CLI reads
# this when it resolves `env(...)` in config.toml.

# The base URL Auth uses to build links in emails, and its redirect allow-list.
#
# MUST differ between environments. Local dev serves the app from Vite, so the
# local value is a localhost origin. Production is the Cloudflare Pages URL,
# and is passed explicitly on the command line when pushing:
#
#   SUPABASE_AUTH_SITE_URL=https://wamda-a8k.pages.dev supabase config push
#
# `supabase config push` does not prompt -- whatever is set here (or missing)
# goes straight to the linked project.
SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3000
