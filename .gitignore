# Secrets — vendor API keys must never be committed.
.env
.env.*
!.env.example
supabase/functions/.env
supabase/.temp/

# Web client
node_modules/
web/dist/
web/dev-dist/
web/.vite/
# Generated by vite-plugin-pwa at build time.
web/public/sw.js
web/public/workbox-*.js

# Deno cache from tooling
deno.lock

# Machine-local editor/agent settings. `.claude/launch.json` IS committed —
# it defines how to run the dev server and is the same for everyone.
.claude/settings.local.json

.DS_Store

# wrangler build/deploy cache
.wrangler/
