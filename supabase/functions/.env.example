# Copy to `supabase/functions/.env` for local development.
# That file is gitignored. In production use `supabase secrets set`.
#
# These three keys are SERVER-SIDE ONLY. None of them may ever appear in the
# web bundle, in a response body, or in a log line. The browser client holds
# the Supabase anon key and nothing else.
#
# Note the contrast with web/.env.local: anything prefixed VITE_ there is
# compiled into JavaScript the user can read. Nothing in THIS file ever is.

ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
COHERE_API_KEY=...

# Injected automatically by the Supabase runtime; listed here so the full set
# of expected variables is visible in one place.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# CORS. Defaults to "*", which is fine locally and wrong in production web.
# ALLOWED_ORIGIN=https://app.example.com
